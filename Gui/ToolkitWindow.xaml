<!--
    Endpoint Toolkit window. Loaded by Gui\ToolkitGui.ps1, which fills it from tools.json.
    Colours are DynamicResource brushes set in code (light or dark, following Windows).
    Icons are glyphs from Windows' own icon font (Segoe Fluent Icons on 11, Segoe MDL2 Assets on 10).
    The title bar is drawn here (WindowChrome) so it can be dark too; no native code involved.
    Every x:Name outside a template is looked up in ToolkitGui.ps1; tests\Test-Repo.ps1 checks they match.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Endpoint Toolkit" Width="1080" Height="700" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Tool list rows -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin scrollbars that suit a dark window -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource Line2}" CornerRadius="3" Margin="3,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border Background="{DynamicResource Line2}" CornerRadius="3" Margin="2,3"/>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Minimise / maximise / close, drawn to match the window -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Muted}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="0,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="17" Height="17" CornerRadius="4" BorderThickness="1" Margin="0,1,0,0"
                      VerticalAlignment="Top" BorderBrush="{DynamicResource Line2}" Background="{DynamicResource Card}">
                <Path x:Name="Tick" Data="M 3,8 L 6.5,11.5 L 12.5,4.5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="0,5,22,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="17" Height="17" Margin="0,1,0,0" VerticalAlignment="Top">
                <Ellipse x:Name="Ring" StrokeThickness="1" Stroke="{DynamicResource Line2}" Fill="{DynamicResource Card}"/>
                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource OnAccent}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Top"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <DockPanel>
      <!-- Title bar: drag to move, double-click to maximise -->
      <Border DockPanel.Dock="Top" Height="52" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock x:Name="HostText" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border x:Name="ElevatedPill" CornerRadius="5" Padding="9,3" VerticalAlignment="Center">
              <TextBlock x:Name="ElevatedText" FontSize="12"/>
            </Border>
            <Button x:Name="AdminButton" Style="{StaticResource SecondaryButton}" Margin="12,0,14,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,7,0"/>
                <TextBlock Text="Relaunch as admin" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}" FontSize="14" Content="&#xE706;" ToolTip="Switch to light mode"/>
            <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimise"/>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximise"/>
            <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                       Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,1,10,0"/>
            <TextBlock Text="Endpoint Toolkit" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" Margin="9,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Runs started from this window -->
      <Border x:Name="RunsPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,8,18,10">
        <StackPanel>
          <TextBlock Text="Runs from this window" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
          <StackPanel x:Name="RunsList"/>
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Tool list -->
        <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <DockPanel Margin="12,14,8,10">
            <Grid DockPanel.Dock="Top" Margin="0,0,4,8">
              <TextBox x:Name="SearchBox"/>
              <TextBlock x:Name="SearchHint" Text="Search tools" IsHitTestVisible="False" FontSize="13.5"
                         Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ListBox x:Name="ToolList" Background="Transparent" BorderThickness="0" Padding="0,0,4,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          </DockPanel>
        </Border>

        <!-- Selected tool -->
        <DockPanel Grid.Column="1" Margin="28,22,28,18">
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <DockPanel>
              <Button x:Name="RunButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="RunIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                             VerticalAlignment="Center" Margin="0,1,8,0"/>
                  <TextBlock x:Name="RunLabel" Text="Run" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="FootText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="0,0,14,0"/>
            </DockPanel>
          </Border>

          <WrapPanel DockPanel.Dock="Top">
            <TextBlock x:Name="ToolName" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,4"/>
            <WrapPanel x:Name="TagPanel" VerticalAlignment="Center" Margin="0,0,0,4"/>
          </WrapPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
            <StackPanel Margin="0,0,10,0">
              <StackPanel x:Name="BriefPanel"/>
              <Border x:Name="WarnBox" CornerRadius="7" Padding="12,9" Margin="0,16,0,0" Visibility="Collapsed"
                      Background="{DynamicResource WarnBg}">
                <TextBlock x:Name="WarnText" TextWrapping="Wrap" Foreground="{DynamicResource WarnFg}"/>
              </Border>
              <TextBlock x:Name="OptionsHeader" Text="Options" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,24,0,6"/>
              <StackPanel x:Name="OptionsPanel"/>
              <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerFg}" TextWrapping="Wrap"
                         Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </DockPanel>
  </Border>
</Window>
